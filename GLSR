local function hookInfiniteCharge(Character)
    task.wait(0.5)

    local shootFunc = nil
    for _, v in pairs(getgc(true)) do
        if type(v) == "table" and typeof(v) == "table" then
            local shoot = rawget(v, "Shoot")
            if type(shoot) == "function" then
                local upvals = debug.getupvalues(shoot)
                local hasPlayer = false
                local hasChar = false
                
                for _, upval in pairs(upvals) do
                    if upval == LocalPlayer then hasPlayer = true end
                    if typeof(upval) == "Instance" and upval == Character then hasChar = true end
                end
                
                if hasPlayer and hasChar then
                    shootFunc = shoot
                    break
                end
            end
        end
    end

    if not shootFunc then return end

    local upvals = debug.getupvalues(shootFunc)
    local powerGuiIndex = nil
    local powerUpvalIndex = nil
    local runServiceIndex = nil

    for i, val in pairs(upvals) do
        if val == RunService then
            runServiceIndex = i
        elseif typeof(val) == "Instance" and val.Name == "Power" and val:IsA("Frame") then
            powerGuiIndex = i
        end
    end

    if powerGuiIndex then
        for i = powerGuiIndex + 1, #upvals do
            if typeof(upvals[i]) == "number" then
                powerUpvalIndex = i
                break
            end
        end
    end

    if not (powerUpvalIndex and runServiceIndex) then return end

    local FakeRunService = {}
    local FakeRenderStepped = {}

    function FakeRenderStepped:Wait()
        local dt = RunService.RenderStepped:Wait()
        
        -- Sync toggle state without breaking the loop structure
        local enabled = true
        if Toggles and Toggles.InfChargeEnabled then
            enabled = Toggles.InfChargeEnabled.Value
        end
        
        if not enabled then return dt end
        
        local power = debug.getupvalue(shootFunc, powerUpvalIndex)
        if type(power) == "number" then
            -- Truncate dt so the game's internal math (power + Rate * dt) NEVER reaches 1.0!
            -- 3.2 is the max rate (used in Header). 2.6 is used in Shoot.
            local max_dt = (0.999 - power) / 3.2
            if max_dt < 0 then max_dt = 0 end
            
            -- If returning the real dt would cause power to exceed 0.999, we throttle it.
            if dt > max_dt then
                return max_dt
            end
        end
        
        return dt
    end

    setmetatable(FakeRenderStepped, {
        __index = function(_, key)
            local val = RunService.RenderStepped[key]
            if type(val) == "function" then
                return function(_, ...) return val(RunService.RenderStepped, ...) end
            end
            return val
        end
    })

    setmetatable(FakeRunService, {
        __index = function(_, key)
            if key == "RenderStepped" then return FakeRenderStepped end
            local val = RunService[key]
            if type(val) == "function" then
                return function(_, ...) return val(RunService, ...) end
            end
            return val
        end
    })

    debug.setupvalue(shootFunc, runServiceIndex, FakeRunService)
end

