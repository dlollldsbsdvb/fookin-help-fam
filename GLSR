local function downsample(points)
    if #points <= 2 then return points end
    local out = {points[1]}
    local prevDir = (points[2] - points[1]).Unit
    local COS_THRESH = math.cos(math.rad(3))
    for i = 2, #points - 1 do
        local d = points[i + 1] - points[i]
        if d.Magnitude > 0.001 then
            local dir = d.Unit
            if prevDir:Dot(dir) < COS_THRESH then
                table.insert(out, points[i])
                prevDir = dir
            end
        end
    end
    table.insert(out, points[#points])
    return out
end

local function getSafeExternalForce(model)
    local total = Vector3.zero
    if not model then return total end
    for _, c in model:GetChildren() do
        if c:IsA("BodyForce") then
            total += c.Force
        elseif c:IsA("VectorForce") and c.Enabled then
            if c.RelativeTo == Enum.ActuatorRelativeTo.World then
                total += c.Force
            end
        end
    end
    return total
end

local function simulate(bd)
    local root   = bd.rootPart
    local pos    = root.Position
    local vel    = root.AssemblyLinearVelocity

    if not isFiniteVec(vel) or not isFiniteVec(pos) then return {} end
    if vel.Magnitude > 5000 then vel = vel.Unit * 5000 end

    local mass = math.max(root:GetMass(), 0.001)
    local extF = getSafeExternalForce(bd.model)
    local accelGravity = Vector3.new(0, -GRAVITY, 0)
    local accelAir = accelGravity + (extF / mass)

    local radius    = bd.radius
    local elast     = math.clamp(bd.elasticity, 0, 1)
    local fric      = math.clamp(bd.friction, 0, 1)
    local dt        = 1/60
    local points    = {pos}
    
    local hasBounced = false
    local MAX_STEPS  = math.ceil(Options.PredMaxTime.Value / dt)

    for _ = 1, MAX_STEPS do
        if vel.Magnitude < 0.1 then break end

        local currentAccel = hasBounced and accelGravity or accelAir
        local remainingDT = dt

        for _ = 1, 4 do
            if remainingDT < 1e-5 then break end

            local nextVel = vel + currentAccel * remainingDT
            local nextPos = pos + vel * remainingDT + 0.5 * currentAccel * remainingDT * remainingDT
            
            if not isFiniteVec(nextPos) or not isFiniteVec(nextVel) then
                remainingDT = 0
                break
            end
            
            local rayDir  = nextPos - pos
            local dist    = rayDir.Magnitude

            if dist > 0.001 and isFiniteVec(rayDir) then
                local castDir = rayDir.Unit
                local hit = workspace:Spherecast(pos, radius, castDir * math.min(dist, 1000), rayParams)

                if hit and isFiniteVec(hit.Normal) then
                    pos = pos + castDir * hit.Distance + hit.Normal * 0.01
                    points[#points + 1] = pos
                    
                    -- Stop predicting the bounce! Let the game engine bounce the ball, 
                    -- and we will recalculate the new trajectory in real-time next frame.
                    return points
                else
                    pos, vel, remainingDT = nextPos, nextVel, 0
                end
            else
                pos, vel, remainingDT = nextPos, nextVel, 0
            end
        end

        points[#points + 1] = pos
    end

    return points
end

RunService.Heartbeat:Connect(function()
    if not Toggles.BallPredictEnabled.Value then hideUnusedLines(1) return end

    local now = tick()
    if now - lastScan >= 0.1 then
        lastScan = now
        refreshFilters()
    end

    local lineIndex = 1

    for _, bd in ipairs(activeBalls) do
        local root  = bd.rootPart
        if root and root.Parent then
            local rawPoints = simulate(bd)
            local points    = downsample(rawPoints)
            local count     = #points

            for i = 1, count - 1 do
                local p1   = points[i]
                local p2   = points[i + 1]
                local dist = (p2 - p1).Magnitude
                if dist > 0.001 then
                    local part = getLinePart(lineIndex)
                    part.Size   = Vector3.new(Options.PredLineWidth.Value / 10, Options.PredLineWidth.Value / 10, dist)
                    part.CFrame = CFrame.lookAt(p1, p2) * CFrame.new(0, 0, -dist / 2)
                    part.Color  = Options.PredLineColor.Value
                    
                    local t = (i - 1) / math.max(count - 1, 1)
                    part.Transparency = t * t * 0.9
                    
                    lineIndex = lineIndex + 1
                end
            end
        end
    end

    hideUnusedLines(lineIndex)
end)

