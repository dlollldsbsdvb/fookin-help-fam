local function getLatency()
    if not TRAP_CONFIG.UseAutoPing then return TRAP_CONFIG.ManualPing end
    
    local success, pingVal = pcall(function()
        local networkStats = Stats.Network:FindFirstChild("ServerStatsItem")
        if networkStats then
            local pingStr = networkStats:FindFirstChild("Data Ping")
            if pingStr then
                local val = tonumber(pingStr:GetValueString():match("%d+"))
                if val then return (val / 1000) / 2 end
            end
        end
        return nil
    end)
    
    if success and pingVal then return pingVal end
    return TRAP_CONFIG.ManualPing
end

